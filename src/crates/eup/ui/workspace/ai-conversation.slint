// The AI tab: a chat with the IncuBrix editing engine.
//
// Nothing here decides anything. Every message, status, option and length
// is the engine's own answer, published by `panes/ai.rs`; this file lays it
// out as a conversation and sends back what was typed or clicked.

import { Theme } from "../theme/theme.slint";

/// One chat message.
export struct AiMessageData {
    /// The user's words (right), or the editor's reply (left).
    mine: bool,
    /// Replies: 0 done, 1 question, 2 not done, 3 undo/redo, 4 working, 5 hello.
    kind: int,
    /// "Done", "Quick question", ...
    title: string,
    text: string,
    /// What changed, one line each.
    changes: [string],
    /// Things worth knowing.
    notes: [string],
    /// Answers to click; only on the question waiting now.
    options: [string],
    /// The rest of a long reply, shown on request.
    more: [string],
}

/// One change in the engine's history.
export struct AiEditData {
    id: int,
    instruction: string,
    operations: string,
    /// 0 in effect, 1 brought back, 2 undone.
    state: int,
    state-label: string,
    can-restore: bool,
}

/// Everything the tab shows.
export struct AiPanelData {
    /// A video is there to edit.
    ready: bool,
    /// Why not, when not.
    not-ready: string,
    /// The file being edited.
    file: string,
    duration: string,
    original: string,
    edits: int,
    can-undo: bool,
    can-redo: bool,
    /// The AI model reading requests; empty when none is set up.
    model: string,
    busy: bool,
    /// A question is waiting for an answer.
    asking: bool,
    transcript: string,
    transcript-detail: string,
    /// 0 none, 1 running, 2 ready, 3 failed.
    transcript-state: int,
    can-transcribe: bool,
    hash: string,
    policy: string,
    parser: string,
    messages: [AiMessageData],
    ledger: [AiEditData],
    captions: [string],
}

global AiTint {
    pure public function of(kind: int) -> color {
        if kind == 0 { return #22c55e; }
        if kind == 1 { return #f59e0b; }
        if kind == 2 { return #ef4444; }
        if kind == 3 { return #60a5fa; }
        return Theme.accent;
    }
}

component AiButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    min-width: label-text.preferred-width + 20px;
    preferred-width: label-text.preferred-width + 20px;
    height: 26px;
    border-radius: Theme.r-sm;
    background: !root.enabled ? Theme.field
        : root.primary ? (touch.has-hover ? Theme.accent.darker(0.12) : Theme.accent)
        : (touch.has-hover ? Theme.field-hover : Theme.field);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.line;
    opacity: root.enabled ? 1.0 : 0.45;

    label-text := Text {
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: root.primary && root.enabled ? Theme.on-accent : Theme.fg;
        font-size: Theme.fs-sm;
        font-weight: 600;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

/// A full-width choice that wraps its words.
component AiChoice inherits Rectangle {
    in property <string> label;
    in property <int> index;
    callback clicked;

    min-height: row.preferred-height;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.accent-soft : Theme.panel;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;

    row := HorizontalLayout {
        padding: 7px;
        spacing: 8px;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: Theme.accent;
            Text {
                text: root.index + 1;
                color: Theme.on-accent;
                font-size: Theme.fs-xs;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.fg;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.fg-muted;
    min-width: label.preferred-width + 12px;
    preferred-width: label.preferred-width + 12px;
    height: 18px;
    border-radius: 9px;
    background: root.tint.with-alpha(0.15);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.45);
    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.tint;
        font-size: Theme.fs-xs;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SectionTitle inherits Text {
    color: Theme.fg-muted;
    font-size: Theme.fs-xs;
    font-weight: 700;
    letter-spacing: 0.6px;
    wrap: word-wrap;
}

component Card inherits Rectangle {
    background: Theme.field;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: Theme.line;
}

/// The user's words: a bubble on the right, as wide as its words.
component UserBubble inherits HorizontalLayout {
    in property <string> text;
    alignment: end;
    padding-left: 36px;

    Rectangle {
        // As wide as the words need, up to the room there is.
        width: Math.min(measure.preferred-width + 24px, root.width - 36px);
        min-height: words.preferred-height + 16px;
        border-radius: 12px;
        background: Theme.accent;

        measure := Text {
            visible: false;
            text: root.text;
            font-size: Theme.fs-sm;
            wrap: no-wrap;
        }
        words := Text {
            x: 12px;
            y: 8px;
            width: parent.width - 24px;
            text: root.text;
            color: Theme.on-accent;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
}

/// The editor's reply: its avatar and a bubble with what it did.
component ReplyBubble inherits HorizontalLayout {
    in property <AiMessageData> message;
    /// The full reply is showing.
    property <bool> open: false;
    callback answer(int);
    spacing: 6px;
    padding-right: 24px;

    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: AiTint.of(root.message.kind == 5 ? 4 : root.message.kind).with-alpha(0.2);
            border-width: 1px;
            border-color: AiTint.of(root.message.kind == 5 ? 4 : root.message.kind).with-alpha(0.6);
            Text {
                text: "AI";
                color: AiTint.of(root.message.kind == 5 ? 4 : root.message.kind);
                font-size: Theme.fs-xs;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    Rectangle {
        horizontal-stretch: 1;
        min-height: body.preferred-height;
        border-radius: 12px;
        background: Theme.field;
        border-width: 1px;
        border-color: root.message.kind == 5 ? Theme.line : AiTint.of(root.message.kind).with-alpha(0.5);

        body := VerticalLayout {
            padding: 10px;
            spacing: 6px;
            if root.message.title != "": HorizontalLayout {
                spacing: 6px;
                Chip { text: root.message.title; tint: AiTint.of(root.message.kind); }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.message.text != "": Text {
                text: root.message.text;
                color: Theme.fg;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
            if root.message.changes.length > 0: VerticalLayout {
                spacing: 3px;
                SectionTitle { text: "WHAT CHANGED"; }
                for change in root.message.changes: HorizontalLayout {
                    spacing: 6px;
                    Text { text: "-"; color: AiTint.of(root.message.kind); font-size: Theme.fs-sm; }
                    Text {
                        horizontal-stretch: 1;
                        text: change;
                        color: Theme.fg;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
            }
            for note in root.message.notes: Text {
                text: "Note: " + note;
                color: #f59e0b;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
            if root.open: VerticalLayout {
                spacing: 3px;
                for line in root.message.more: Text {
                    text: line;
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
            }
            if root.message.more.length > 0: Text {
                text: root.open ? "Show less" : "Show " + root.message.more.length + " more";
                color: Theme.accent;
                font-size: Theme.fs-xs;
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open = !root.open; }
                }
            }
            for option[i] in root.message.options: AiChoice {
                label: option;
                index: i;
                clicked => { root.answer(i); }
            }
        }
    }
}

export component AIConversationDashboard inherits Rectangle {
    in property <AiPanelData> data;
    in-out property <int> category: 0;
    in-out property <string> prompt-text: "";
    in-out property <bool> details: false;

    callback say(string);
    callback answer(int);
    callback undo-action();
    callback redo-action();
    callback reset-session();
    callback transcribe();
    callback restore(int);

    background: Theme.panel;
    clip: true;

    function send() {
        if (root.prompt-text != "" && root.data.ready && !root.data.busy) {
            root.say(root.prompt-text);
            root.prompt-text = "";
            root.category = 0;
        }
    }

    VerticalLayout {
        padding: 8px;
        padding-right: 10px;
        spacing: 8px;

        // ── Header: what is being edited, at a glance ──
        Card {
            min-height: head.preferred-height;
            head := VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.data.model != "" ? #22c55e : Theme.fg-muted;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.data.model != "" ? "AI editor  ·  " + root.data.model : "AI editor  ·  common phrases only";
                        color: Theme.fg;
                        font-size: Theme.fs-sm;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: !root.data.ready ? root.data.not-ready
                        : root.data.file + "  ·  " + root.data.duration
                            + (root.data.duration != root.data.original ? " (was " + root.data.original + ")" : "")
                            + "  ·  " + (root.data.edits == 1 ? "1 change" : root.data.edits + " changes");
                    color: Theme.fg-muted;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                if root.data.ready: HorizontalLayout {
                    spacing: 6px;
                    AiButton {
                        label: "Undo";
                        enabled: root.data.can-undo && !root.data.busy;
                        clicked => { root.undo-action(); }
                    }
                    AiButton {
                        label: "Redo";
                        enabled: root.data.can-redo && !root.data.busy;
                        clicked => { root.redo-action(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    AiButton {
                        label: "New chat";
                        enabled: root.data.messages.length > 1 && !root.data.busy;
                        clicked => { root.reset-session(); }
                    }
                }
            }
        }

        // ── The conversation (or another page), scrolling ──
        list := Flickable {
            vertical-stretch: 1;
            // Its width comes from the tab, never from the messages: they
            // size themselves to it.
            min-width: 0px;
            max-width: 100000px;
            min-height: 80px;
            content-width: self.width;
            content-height: Math.max(self.height, msgs.preferred-height);
            // New messages arrive at the bottom: follow them.
            changed content-height => {
                self.content-y = Math.min(0px, self.height - self.content-height);
            }

            msgs := VerticalLayout {
                width: list.width;
                height: list.content-height;
                spacing: 8px;
                alignment: end;

                if root.category == 0: VerticalLayout {
                    spacing: 8px;
                    for m in root.data.messages: VerticalLayout {
                        if m.mine: UserBubble { text: m.text; }
                        if !m.mine: ReplyBubble {
                            message: m;
                            answer(i) => { root.answer(i); }
                        }
                    }
                }

                if root.category == 1: VerticalLayout {
                    spacing: 8px;
                    SectionTitle { text: "YOUR CHANGES (NEWEST FIRST)"; }
                    if root.data.ledger.length == 0: Text {
                        text: "No changes yet. Your original video is never touched; every change can be undone or brought back.";
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                    for edit in root.data.ledger: Card {
                        min-height: row.preferred-height;
                        opacity: edit.state == 0 ? 1.0 : 0.7;
                        row := VerticalLayout {
                            padding: 10px;
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "#" + edit.id + "  " + edit.instruction;
                                    color: Theme.fg;
                                    font-size: Theme.fs-sm;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                                VerticalLayout {
                                    alignment: start;
                                    Chip {
                                        text: edit.state-label;
                                        tint: edit.state == 0 ? #22c55e : edit.state == 1 ? #60a5fa : Theme.fg-muted;
                                    }
                                }
                            }
                            if root.details: Text {
                                text: edit.operations;
                                color: Theme.fg-muted;
                                font-size: Theme.fs-sm;
                                wrap: word-wrap;
                            }
                            if edit.can-restore: HorizontalLayout {
                                Rectangle { horizontal-stretch: 1; }
                                AiButton {
                                    label: "Undo just this change";
                                    clicked => { root.restore(edit.id); }
                                }
                            }
                        }
                    }
                    if root.data.captions.length > 0: SectionTitle { text: "CAPTIONS"; }
                    for c in root.data.captions: Text {
                        text: c;
                        color: Theme.fg;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }

                if root.category == 2: VerticalLayout {
                    spacing: 6px;
                    SectionTitle { text: "WORKED EXAMPLE - CLICK TO SEND"; }
                    for line[i] in [
                        "Add a caption 'Welcome!' when I say welcome to the channel",
                        "Cut the first 30 seconds",
                        "Remove the part about pricing",
                        "Speed up from 1:00 to 1:30 by 2x",
                        "Actually, put the intro back",
                        "Undo",
                        "Make that caption red",
                    ]: AiChoice {
                        label: line;
                        index: i;
                        clicked => {
                            root.prompt-text = line;
                            root.send();
                        }
                    }
                    Text {
                        text: "Steps 1 and 3 need speech with those words. Times mean the video as it plays now.";
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }

                if root.category == 3: VerticalLayout {
                    spacing: 6px;
                    SectionTitle { text: "ONE-CLICK REQUESTS"; }
                    for line[i] in [
                        "Remove the filler words",
                        "Remove silences longer than 1 second",
                        "Auto-caption the whole video",
                        "Bleep the swearing",
                        "Make it shorter",
                        "Cut the last 5 seconds",
                    ]: AiChoice {
                        label: line;
                        index: i;
                        clicked => {
                            root.prompt-text = line;
                            root.send();
                        }
                    }
                }

                // Speech and the technical side, after the pages.
                if root.data.ready: Card {
                    min-height: speech.preferred-height;
                    speech := VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: root.data.transcript;
                                color: root.data.transcript-state == 3 ? #ef4444 : Theme.fg-muted;
                                font-size: Theme.fs-xs;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                            if root.data.can-transcribe: AiButton {
                                label: root.data.transcript-state == 2 ? "Re-analyse" : "Analyse speech";
                                enabled: root.data.transcript-state != 1 && !root.data.busy;
                                clicked => { root.transcribe(); }
                            }
                        }
                        Text {
                            text: root.details ? "Hide technical details" : "Show technical details";
                            color: Theme.accent;
                            font-size: Theme.fs-xs;
                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.details = !root.details; }
                            }
                        }
                        if root.details: Text {
                            text: "Timeline hash " + root.data.hash + ". " + root.data.policy + ". Reader: " + root.data.parser + ". "
                                + root.data.transcript-detail
                                + " The AI only turns your words into a request; the editing engine makes every change, and each one is a single undo step here and on the timeline.";
                            color: Theme.fg-muted;
                            font-size: Theme.fs-xs;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ── The composer: always in reach, never pushed off ──
        Rectangle {
            height: 38px;
            border-radius: Theme.r;
            background: Theme.field;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.line;

            HorizontalLayout {
                padding: 5px;
                padding-left: 10px;
                spacing: 6px;

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    preferred-width: 0px;
                    clip: true;
                    input := TextInput {
                        width: parent.width;
                        height: parent.height;
                        font-size: Theme.fs;
                        color: Theme.fg;
                        single-line: true;
                        vertical-alignment: center;
                        enabled: root.data.ready && !root.data.busy;
                        text <=> root.prompt-text;
                        accepted => { root.send(); }
                    }
                    if root.prompt-text == "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.data.busy ? "Working on it..."
                            : root.data.asking ? "Pick an option above, or reply in your own words..."
                            : root.data.model != "" ? "Tell me what to change, in your own words..."
                            : "Tell me what to change (e.g. cut the first 30 seconds)...";
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                AiButton {
                    label: root.data.busy ? "..." : "Send";
                    primary: true;
                    enabled: root.data.ready && root.prompt-text != "" && !root.data.busy;
                    clicked => { root.send(); }
                }
            }
        }
    }
}
