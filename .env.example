# ==============================================================
# IncuBrix Video Editing Engine Environment Configuration
# ==============================================================

# API Settings
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# LLM Brain Configuration (mock, openai, gemini, anthropic, ollama)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Speech-To-Text Configuration
STT_PROVIDER=whisper
WHISPER_MODEL=large-v3

# Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix-outputs

# Engine Constraints & Security
MAX_VIDEO_DURATION_S=7200.0
MAX_UPLOAD_SIZE_MB=2048
WEBHOOK_SECRET=incubrix_secret_key_123
TIME_POLICY=original_time
