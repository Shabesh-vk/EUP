# IncuBrix Video Editing Engine Environment Configuration

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_V1_PREFIX=/api/v1

# Storage Configuration (S3-compatible / Local mount)
STORAGE_DIR=storage_data
STORAGE_PUBLIC_URL=http://localhost:8000/api/v1/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=incubrix_admin
S3_SECRET_KEY=incubrix_password_secure
S3_BUCKET_NAME=incubrix-media
S3_REGION=us-east-1

# Processing & Limits
MAX_UPLOAD_SIZE_MB=500
TIME_POLICY=current_edited_time
JOB_TIMEOUT_SECONDS=300
WEBHOOK_SIGNING_SECRET=incubrix_secret_key_123

# AI & Model Providers
STT_PROVIDER=mock          # Options: "mock", "whisper", "deepgram", "openai"
NLU_PROVIDER=rule_based    # Options: "rule_based", "openai", "gemini", "anthropic"

# Optional External API Keys (Leave blank to use deterministic local/mock adapters)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=

# Local Executable Paths (Optional overrides; auto-discovered if blank)
FFMPEG_PATH=
FFPROBE_PATH=
