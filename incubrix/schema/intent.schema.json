{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intent",
  "description": "One instruction's meaning.",
  "oneOf": [
    {
      "description": "Remove something.",
      "type": "object",
      "required": [
        "intent",
        "target"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "cut"
          ]
        },
        "target": {
          "description": "What.",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        }
      }
    },
    {
      "description": "Remove everything except something.",
      "type": "object",
      "required": [
        "intent",
        "target"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "keep_only"
          ]
        },
        "target": {
          "description": "What stays.",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        }
      }
    },
    {
      "description": "Move a section.",
      "type": "object",
      "required": [
        "intent",
        "target",
        "to"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "move"
          ]
        },
        "target": {
          "description": "What moves.",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        },
        "to": {
          "description": "Where to.",
          "allOf": [
            {
              "$ref": "#/definitions/Place"
            }
          ]
        }
      }
    },
    {
      "description": "Play something faster or slower.",
      "type": "object",
      "required": [
        "intent",
        "speed",
        "target"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "speed"
          ]
        },
        "speed": {
          "description": "Thousandths: 2000 = 2x, 500 = half speed.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "target": {
          "description": "What (everything when not said).",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        }
      }
    },
    {
      "description": "Silence words.",
      "type": "object",
      "required": [
        "intent",
        "target"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "mute"
          ]
        },
        "target": {
          "description": "What.",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        }
      }
    },
    {
      "description": "Bleep words.",
      "type": "object",
      "required": [
        "intent",
        "target"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "bleep"
          ]
        },
        "target": {
          "description": "What.",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        }
      }
    },
    {
      "description": "Add a caption on content.",
      "type": "object",
      "required": [
        "intent",
        "target",
        "text"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "add_caption"
          ]
        },
        "target": {
          "description": "Where: words said, or a time.",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        },
        "text": {
          "description": "The text shown.",
          "type": "string"
        }
      }
    },
    {
      "description": "Change how a caption looks.",
      "type": "object",
      "required": [
        "caption",
        "change",
        "intent"
      ],
      "properties": {
        "caption": {
          "description": "Which caption.",
          "allOf": [
            {
              "$ref": "#/definitions/CaptionRef"
            }
          ]
        },
        "change": {
          "description": "What changes.",
          "allOf": [
            {
              "$ref": "#/definitions/StyleChange"
            }
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "style_caption"
          ]
        }
      }
    },
    {
      "description": "Change a caption's words.",
      "type": "object",
      "required": [
        "caption",
        "intent",
        "text"
      ],
      "properties": {
        "caption": {
          "description": "Which caption.",
          "allOf": [
            {
              "$ref": "#/definitions/CaptionRef"
            }
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "retext_caption"
          ]
        },
        "text": {
          "description": "New text.",
          "type": "string"
        }
      }
    },
    {
      "description": "Take a caption away.",
      "type": "object",
      "required": [
        "caption",
        "intent"
      ],
      "properties": {
        "caption": {
          "description": "Which caption.",
          "allOf": [
            {
              "$ref": "#/definitions/CaptionRef"
            }
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "remove_caption"
          ]
        }
      }
    },
    {
      "description": "Caption the whole video from the transcript.",
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "auto_caption"
          ]
        }
      }
    },
    {
      "description": "Remove um, uh and filler \"like\".",
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "remove_fillers"
          ]
        }
      }
    },
    {
      "description": "Remove silences longer than a threshold.",
      "type": "object",
      "required": [
        "intent",
        "min_ms"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "remove_silences"
          ]
        },
        "min_ms": {
          "description": "Threshold, milliseconds.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    {
      "description": "Keep a pause through later silence removal.",
      "type": "object",
      "required": [
        "intent",
        "target"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "keep_pause"
          ]
        },
        "target": {
          "description": "The pause (after a phrase, or a time span).",
          "allOf": [
            {
              "$ref": "#/definitions/Target"
            }
          ]
        }
      }
    },
    {
      "description": "Add background music that ducks under speech.",
      "type": "object",
      "required": [
        "intent",
        "path"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "add_music"
          ]
        },
        "path": {
          "description": "File path or URL.",
          "type": "string"
        }
      }
    },
    {
      "description": "Take the music away.",
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "remove_music"
          ]
        }
      }
    },
    {
      "description": "Step back.",
      "type": "object",
      "required": [
        "intent",
        "steps"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "undo"
          ]
        },
        "steps": {
          "description": "How many instructions.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    {
      "description": "Step forward.",
      "type": "object",
      "required": [
        "intent",
        "steps"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "redo"
          ]
        },
        "steps": {
          "description": "How many instructions.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    {
      "description": "Switch one earlier edit off, keeping everything after it.",
      "type": "object",
      "required": [
        "edit",
        "intent"
      ],
      "properties": {
        "edit": {
          "description": "Which edit.",
          "allOf": [
            {
              "$ref": "#/definitions/EditRef"
            }
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "restore"
          ]
        },
        "keep": {
          "description": "Anything the user asked to keep while restoring (\"but keep the music\").",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "description": "Produce the video (a separate step).",
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "render"
          ]
        }
      }
    },
    {
      "description": "A goal too vague to act on without asking.",
      "type": "object",
      "required": [
        "goal",
        "intent"
      ],
      "properties": {
        "goal": {
          "description": "What kind.",
          "allOf": [
            {
              "$ref": "#/definitions/VagueGoal"
            }
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "vague"
          ]
        }
      }
    },
    {
      "description": "Several instructions in one message, applied together or not at all.",
      "type": "object",
      "required": [
        "intent",
        "parts"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "multi"
          ]
        },
        "parts": {
          "description": "The parts, in order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Part"
          }
        }
      }
    },
    {
      "description": "Not understood.",
      "type": "object",
      "required": [
        "intent",
        "reason"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "unknown"
          ]
        },
        "reason": {
          "description": "Why, for the user.",
          "type": "string"
        }
      }
    }
