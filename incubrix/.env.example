# Every setting the service reads. Copy to .env to change any; the values
# shown are the defaults. No API key is needed for anything.

# --- the API ---
API_BIND=0.0.0.0:8080            # address to listen on
PUBLIC_URL=http://localhost:8080 # how clients reach the API (links in local storage mode)
DATA_DIR=/data                   # database, uploads, working files
MAX_UPLOAD_MB=2048               # largest upload or download
LOG_LEVEL=info                   # error | warn | info | debug (JSON logs on stdout)

# --- result storage (files out) ---
STORAGE=s3                       # s3 (SeaweedFS, MinIO, AWS - any S3) | local (a folder, served by the API)
S3_ENDPOINT=http://s3:9000       # where the API reaches the store
S3_PUBLIC_ENDPOINT=http://localhost:9000  # where clients reach it; presigned links use this host
S3_BUCKET=incubrix
S3_REGION=us-east-1
S3_ACCESS_KEY=incubrix
S3_SECRET_KEY=incubrix-secret
LINK_TTL_SECONDS=3600            # lifetime of presigned links

# --- jobs ---
CALLBACK_SECRET=change-me        # HMAC-SHA256 key for X-IncuBrix-Signature on callbacks

# --- speech recognition ---
WHISPER_MODEL=/models/ggml-tiny.en.bin   # ggml model (the image ships tiny.en)

# --- reading instructions ---
NLU_PROVIDER=rules               # rules (deterministic, default) | anthropic | openai | ollama
NLU_MODEL=                       # model for an LLM provider (e.g. claude-opus-5-5, llama3.1:8b)
ANTHROPIC_API_KEY=               # only for NLU_PROVIDER=anthropic
OPENAI_API_KEY=                  # only for NLU_PROVIDER=openai
OLLAMA_URL=http://127.0.0.1:11434
NLU_CACHE_DIR=/data/nlu-cache    # cached model answers: reruns need no network

# --- tools ---
FFMPEG=ffmpeg
FFPROBE=ffprobe

# Public deployment
API_TOKEN=                       # when set, /api/v1 needs "Authorization: Bearer <token>"
RATE_LIMIT_PER_MINUTE=120        # requests per client per minute (0 = off)
TRUST_FORWARDED=false            # read the client from X-Forwarded-For (behind your own proxy only)
